---
import "../styles/global.css";

const whatsapp = "https://wa.me/+5493424443500?text=Hola%20Concat%20Studio%2C%20quiero%20consultar%20por%20un%20proyecto";
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#020617" />

    <!-- Reemplazá estas rutas si todavía no tenés el favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>Concat Studio | Apps móviles y soluciones digitales</title>
    <meta
      name="description"
      content="Concat Studio desarrolla aplicaciones móviles, APIs, soluciones cloud y paneles web a medida."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-slate-950 font-['Plus_Jakarta_Sans',sans-serif] text-slate-100 antialiased selection:bg-sky-500/30 selection:text-white">

    <!-- =========================================================
         NAVBAR
         ========================================================= -->
    <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 lg:px-6">

        <a href="#inicio" class="group flex items-center gap-3" aria-label="Concat Studio - Inicio">
          <!-- Logo -->
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500 shadow-lg shadow-sky-500/20 transition-transform group-hover:scale-105">
            <svg viewBox="0 0 48 48" class="h-7 w-7 text-white" fill="none" aria-hidden="true">
              <rect x="10" y="4" width="28" height="40" rx="7" stroke="currentColor" stroke-width="4"/>
              <path d="M21 17l-7 7 7 7M27 17l7 7-7 7" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20 10h8" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>

          <div>
            <div class="text-lg font-extrabold tracking-tight leading-none">CONCAT</div>
            <div class="mt-1 text-[10px] font-semibold tracking-[0.28em] text-sky-400">STUDIO</div>
          </div>
        </a>

        <nav class="hidden items-center gap-8 text-sm text-slate-300 md:flex">
          <a href="#servicios" class="transition hover:text-white">Servicios</a>
          <a href="#proceso" class="transition hover:text-white">Cómo trabajamos</a>
          <a href="#contacto" class="transition hover:text-white">Contacto</a>
        </nav>

        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-sky-500 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-sky-500/20 transition hover:bg-sky-400 hover:-translate-y-0.5"
        >
          Cotizar proyecto
        </a>
      </div>
    </header>


    <main id="inicio">

      <!-- =======================================================
           HERO
           ======================================================= -->
      <section class="relative isolate overflow-hidden">
        <!-- Decoración -->
        <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-sky-500/10 blur-[130px]"></div>
        <div class="pointer-events-none absolute right-0 top-40 -z-10 h-72 w-72 rounded-full bg-blue-600/10 blur-[100px]"></div>

        <div class="mx-auto grid max-w-6xl items-center gap-16 px-5 py-20 lg:grid-cols-12 lg:px-6 lg:py-28">

          <div class="lg:col-span-7">
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/10 px-3.5 py-1.5 text-xs font-semibold text-sky-300">
              <span class="h-2 w-2 animate-pulse rounded-full bg-sky-400"></span>
              Venado Tuerto · Santa Fe
            </div>

            <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
              Tu idea puede convertirse en una
              <span class="bg-gradient-to-r from-sky-300 via-sky-400 to-blue-500 bg-clip-text text-transparent">
                 aplicación.
              </span>
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
              En <strong class="text-white">Concat Studio</strong> desarrollamos aplicaciones
              móviles y soluciones digitales a medida para transformar ideas y procesos
              de negocio en productos simples, modernos y escalables.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl bg-sky-500 px-6 py-3.5 text-center font-bold text-white shadow-xl shadow-sky-500/20 transition hover:-translate-y-0.5 hover:bg-sky-400"
              >
                Hablemos de tu proyecto →
              </a>

              <a
                href="#servicios"
                class="rounded-xl border border-white/10 bg-white/[0.03] px-6 py-3.5 text-center font-semibold text-slate-200 transition hover:bg-white/[0.07]"
              >
                Ver servicios
              </a>
            </div>

            <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-400">
              <span>✓ Android & iOS</span>
              <span>✓ APIs & Cloud</span>
              <span>✓ Paneles web</span>
            </div>
          </div>


          <!-- Mockup de aplicación -->
          <div class="relative flex justify-center lg:col-span-5">
            <div class="absolute h-72 w-72 rounded-full bg-sky-500/20 blur-3xl"></div>

            <div class="relative w-[280px] rounded-[42px] border-[7px] border-slate-800 bg-slate-900 p-3 shadow-2xl shadow-black/50">
              <!-- Cámara / notch -->
              <div class="absolute left-1/2 top-2 z-10 h-5 w-24 -translate-x-1/2 rounded-full bg-slate-800"></div>

              <div class="overflow-hidden rounded-[30px] bg-slate-950">
                <div class="px-5 pb-7 pt-10">

                  <div class="mb-7 flex items-center justify-between">
                    <div>
                      <p class="text-[10px] text-slate-500">CONCAT STUDIO</p>
                      <p class="mt-1 text-lg font-bold text-white">Mi aplicación</p>
                    </div>

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/15 text-sky-400">
                      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="6" y="2.5" width="12" height="19" rx="3"/>
                        <path d="M9 9l-2.5 3L9 15M15 9l2.5 3-2.5 3"/>
                      </svg>
                    </div>
                  </div>

                  <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                    <p class="text-xs text-slate-400">Ventas del mes</p>
                    <p class="mt-1 text-3xl font-extrabold text-white">$ 2.450.000</p>
                    <div class="mt-5 h-20 rounded-xl bg-gradient-to-t from-sky-500/20 to-transparent p-2">
                      <div class="flex h-full items-end gap-2">
                        <span class="h-7 w-full rounded-t bg-sky-500/30"></span>
                        <span class="h-11 w-full rounded-t bg-sky-500/40"></span>
                        <span class="h-9 w-full rounded-t bg-sky-500/50"></span>
                        <span class="h-14 w-full rounded-t bg-sky-500/60"></span>
                        <span class="h-12 w-full rounded-t bg-sky-500/70"></span>
                     	<span class="h-16 w-full rounded-t bg-sky-500"></span>
                      </div>
                    </div>
                  </div>

                  <div class="mt-4 grid grid-cols-2 gap-3">
                    <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                      <p class="text-[10px] text-slate-500">Pedidos</p>
                      <p class="mt-1 text-xl font-bold">128</p>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                      <p class="text-[10px] text-slate-500">Clientes</p>
                      <p class="mt-1 text-xl font-bold">84</p>
                    </div>
                  </div>

                  <div class="mt-5 rounded-xl bg-sky-500 py-3 text-center text-xs font-bold text-white shadow-lg shadow-sky-500/20">
                    Ver pedidos
                  </div>
                </div>
              </div>

              <div class="mx-auto mt-3 h-1 w-20 rounded-full bg-slate-700"></div>
            </div>
          </div>
        </div>
      </section>


      <!-- =======================================================
           SERVICIOS
           ======================================================= -->
      <section id="servicios" class="border-y border-white/5 bg-slate-900/60">
        <div class="mx-auto max-w-6xl px-5 py-20 lg:px-6">

          <div class="max-w-2xl">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-sky-400">Servicios</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
              Una solución digital, de punta a punta.
            </h2>
            <p class="mt-4 leading-relaxed text-slate-400">
              Desde la primera pantalla hasta la infraestructura que funciona detrás.
              La idea es que tengas una solución clara y puedas crecer sobre ella.
            </p>
          </div>

          <div class="mt-12 grid gap-5 md:grid-cols-3">

            <!-- Servicio 1 -->
            <article class="group rounded-2xl border border-white/10 bg-slate-950/70 p-7 transition hover:-translate-y-1 hover:border-sky-400/40">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="6" y="2.5" width="12" height="19" rx="3"/>
                  <path d="M9 9l-2.5 3L9 15M15 9l2.5 3-2.5 3"/>
                </svg>
              </div>

              <h3 class="mt-6 text-xl font-bold">Apps Mobile</h3>
              <p class="mt-3 text-sm leading-6 text-slate-400">
                Aplicaciones para Android e iOS pensadas para ventas, pedidos,
                clientes, operaciones internas y nuevos productos digitales.
              </p>

              <div class="mt-6 text-xs font-semibold text-sky-400">
                Android · iOS · Multiplataforma
              </div>
            </article>


            <!-- Servicio 2 -->
            <article class="group rounded-2xl border border-white/10 bg-slate-950/70 p-7 transition hover:-translate-y-1 hover:border-sky-400/40">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M7 7h10M7 12h10M7 17h6"/>
                  <path d="M4 4h16v16H4z"/>
                </svg>
              </div>

              <h3 class="mt-6 text-xl font-bold">APIs & Cloud</h3>
              <p class="mt-3 text-sm leading-6 text-slate-400">
                El backend que conecta tu aplicación con datos, usuarios,
                autenticación, notificaciones, servicios externos y procesos.
              </p>

              <div class="mt-6 text-xs font-semibold text-sky-400">
                APIs · Base de datos · Integraciones
              </div>
            </article>


            <!-- Servicio 3 -->
            <article class="group rounded-2xl border border-white/10 bg-slate-950/70 p-7 transition hover:-translate-y-1 hover:border-sky-400/40">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="4" width="18" height="16" rx="2"/>
                  <path d="M3 9h18M8 13h3M8 16h6"/>
                </svg>
              </div>

              <h3 class="mt-6 text-xl font-bold">Paneles Web</h3>
              <p class="mt-3 text-sm leading-6 text-slate-400">
                Interfaces web para administrar ventas, stock, clientes,
                pedidos y métricas desde cualquier dispositivo.
              </p>

              <div class="mt-6 text-xs font-semibold text-sky-400">
                Dashboards · Gestión · Métricas
              </div>
            </article>

          </div>
        </div>
      </section>


      <!-- =======================================================
           PROCESO
           ======================================================= -->
      <section id="proceso">
        <div class="mx-auto max-w-6xl px-5 py-20 lg:px-6">

          <div class="text-center">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-sky-400">Proceso</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
              De la idea al producto.
            </h2>
            <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-slate-400">
              Un proceso simple para transformar una necesidad concreta en una solución digital.
            </p>
          </div>

          <div class="relative mt-14 grid gap-10 md:grid-cols-4">

            <div class="hidden md:absolute md:left-[12%] md:right-[12%] md:top-6 md:block md:border-t md:border-dashed md:border-slate-700"></div>

            <div class="relative text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-sky-400/30 bg-sky-500/10 font-bold text-sky-400">01</div>
              <h3 class="mt-5 font-bold">Entendemos</h3>
              <p class="mt-2 text-sm leading-6 text-slate-400">Definimos el problema, objetivos y alcance.</p>
            </div>

            <div class="relative text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-sky-400/30 bg-sky-500/10 font-bold text-sky-400">02</div>
              <h3 class="mt-5 font-bold">Diseñamos</h3>
              <p class="mt-2 text-sm leading-6 text-slate-400">Convertimos la idea en una experiencia clara.</p>
            </div>

            <div class="relative text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-sky-400/30 bg-sky-500/10 font-bold text-sky-400">03</div>
              <h3 class="mt-5 font-bold">Desarrollamos</h3>
              <p class="mt-2 text-sm leading-6 text-slate-400">Construimos la app, backend e integraciones.</p>
            </div>

            <div class="relative text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-sky-400/30 bg-sky-500/10 font-bold text-sky-400">04</div>
              <h3 class="mt-5 font-bold">Lanzamos</h3>
              <p class="mt-2 text-sm leading-6 text-slate-400">Ponemos la solución en funcionamiento.</p>
            </div>

          </div>
        </div>
      </section>


      <!-- =======================================================
           CTA
           ======================================================= -->
      <section id="contacto" class="px-5 pb-20 lg:px-6">
        <div class="mx-auto max-w-6xl overflow-hidden rounded-3xl border border-sky-400/20 bg-gradient-to-br from-sky-500/15 via-slate-900 to-slate-900 p-8 sm:p-12">

          <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto]">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.2em] text-sky-400">¿Tenés una idea?</p>
              <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
                Hablemos de lo que querés construir.
              </h2>
              <p class="mt-4 max-w-2xl leading-relaxed text-slate-400">
                Contame qué necesitás, qué problema querés resolver y vemos juntos
                cómo convertirlo en una solución digital.
              </p>
            </div>

            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl bg-sky-500 px-7 py-4 text-center font-bold text-white shadow-xl shadow-sky-500/20 transition hover:-translate-y-0.5 hover:bg-sky-400"
            >
              Contactar por WhatsApp
            </a>
          </div>

        </div>
      </section>

    </main>


    <!-- =========================================================
         FOOTER
         ========================================================= -->
    <footer class="border-t border-white/10">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between lg:px-6">

        <div>
          <p class="font-semibold text-slate-300">Concat Studio</p>
          <p class="mt-1">Desarrollo de aplicaciones y soluciones digitales.</p>
        </div>

        <div class="text-left sm:text-right">
          <p>Venado Tuerto, Santa Fe</p>
          <a
            href="mailto:concat.studio.vt@gmail.com"
            class="mt-1 inline-block text-sky-400 transition hover:text-sky-300 hover:underline"
          >
            concat.studio.vt@gmail.com
          </a>
        </div>

      </div>

      <div class="border-t border-white/5 py-5 text-center text-xs text-slate-600">
        © {new Date().getFullYear()} Concat Studio. Todos los derechos reservados.
      </div>
    </footer>

  </body>
</html>
